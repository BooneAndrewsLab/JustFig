{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "src/brand.ts",
    "src/core/model/hash.ts",
    "src/types/utif.d.ts",
    "eslint.config.js",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
