{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Obj"
      }
    },
    "assets": {
      "$ref": "#/definitions/Assets"
    },
    "format": {
      "type": "string",
      "const": "justfig-fragment"
    },
    "schemaVersion": {
      "type": "number"
    }
  },
  "required": [
    "assets",
    "format",
    "objects",
    "schemaVersion"
  ],
  "additionalProperties": false,
  "description": "The fragment as written to the clipboard or a file: the contract with sibling apps (note 05).",
  "definitions": {
    "Obj": {
      "anyOf": [
        {
          "$ref": "#/definitions/Rect"
        },
        {
          "$ref": "#/definitions/Ellipse"
        },
        {
          "$ref": "#/definitions/PathObj"
        },
        {
          "$ref": "#/definitions/Arrow"
        },
        {
          "$ref": "#/definitions/Text"
        },
        {
          "$ref": "#/definitions/Icon"
        },
        {
          "$ref": "#/definitions/Image"
        },
        {
          "$ref": "#/definitions/Procedural"
        },
        {
          "$ref": "#/definitions/Group"
        },
        {
          "$ref": "#/definitions/Panel"
        },
        {
          "$ref": "#/definitions/Embedded"
        }
      ]
    },
    "Rect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "rect"
        },
        "rx": {
          "type": "number"
        },
        "style": {
          "$ref": "#/definitions/ShapeStyle"
        }
      },
      "required": [
        "frame",
        "id",
        "opacity",
        "rx",
        "style",
        "type"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "description": "Stable ids for everything a project holds (note 02). An id never changes once made, so renaming or reordering never breaks a reference.\n\nThe prefix says what the id names, which keeps saved files and bug reports readable: `d_` document, `pg_` page, `ly_` layer, `o_` object, `ts_` text style, `sw_` swatch."
    },
    "Frame": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "rotation": {
          "type": "number",
          "description": "Degrees, clockwise on screen, about the frame centre."
        },
        "flipX": {
          "type": "boolean"
        },
        "flipY": {
          "type": "boolean"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "rotation"
      ],
      "additionalProperties": false,
      "description": "Top-left of the unrotated box; flipped about, then rotated about, its centre."
    },
    "ShapeStyle": {
      "type": "object",
      "properties": {
        "fill": {
          "anyOf": [
            {
              "$ref": "#/definitions/Paint"
            },
            {
              "type": "null"
            }
          ]
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/definitions/Paint"
            },
            {
              "type": "null"
            }
          ]
        },
        "strokeWidth": {
          "type": "number"
        },
        "dash": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "cap": {
          "$ref": "#/definitions/LineCap"
        },
        "join": {
          "$ref": "#/definitions/LineJoin"
        }
      },
      "required": [
        "fill",
        "stroke",
        "strokeWidth",
        "cap",
        "join"
      ],
      "additionalProperties": false
    },
    "Paint": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "hex": {
              "type": "string"
            }
          },
          "required": [
            "hex"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "swatch": {
              "$ref": "#/definitions/SwatchId"
            }
          },
          "required": [
            "swatch"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SwatchId": {
      "type": "string"
    },
    "LineCap": {
      "type": "string",
      "enum": [
        "butt",
        "round",
        "square"
      ]
    },
    "LineJoin": {
      "type": "string",
      "enum": [
        "miter",
        "round",
        "bevel"
      ]
    },
    "Ellipse": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "ellipse"
        },
        "style": {
          "$ref": "#/definitions/ShapeStyle"
        }
      },
      "required": [
        "frame",
        "id",
        "opacity",
        "style",
        "type"
      ],
      "additionalProperties": false
    },
    "PathObj": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "path"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathNode"
          }
        },
        "closed": {
          "type": "boolean"
        },
        "style": {
          "$ref": "#/definitions/ShapeStyle"
        }
      },
      "required": [
        "closed",
        "frame",
        "id",
        "nodes",
        "opacity",
        "style",
        "type"
      ],
      "additionalProperties": false
    },
    "PathNode": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "in": {
          "$ref": "#/definitions/Vec2"
        },
        "out": {
          "$ref": "#/definitions/Vec2"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "description": "A path vertex with optional cubic handles, frame-local; no handle = corner."
    },
    "Vec2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "Arrow": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "arrow"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathNode"
          }
        },
        "start": {
          "$ref": "#/definitions/Head"
        },
        "end": {
          "$ref": "#/definitions/Head"
        },
        "style": {
          "$ref": "#/definitions/ShapeStyle"
        },
        "bind": {
          "type": "object",
          "properties": {
            "start": {
              "$ref": "#/definitions/Id"
            },
            "end": {
              "$ref": "#/definitions/Id"
            }
          },
          "additionalProperties": false,
          "description": "Binding to objects: Phase 4; kept losslessly now."
        }
      },
      "required": [
        "end",
        "frame",
        "id",
        "nodes",
        "opacity",
        "start",
        "style",
        "type"
      ],
      "additionalProperties": false
    },
    "Head": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/HeadKind"
        },
        "size": {
          "type": "number",
          "description": "Head length as a multiple of the stroke width."
        }
      },
      "required": [
        "kind",
        "size"
      ],
      "additionalProperties": false
    },
    "HeadKind": {
      "type": "string",
      "enum": [
        "none",
        "triangle",
        "open",
        "stealth",
        "bar",
        "circle",
        "diamond"
      ]
    },
    "Text": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "text"
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Run"
            }
          },
          "description": "Paragraphs of runs."
        },
        "align": {
          "$ref": "#/definitions/TextAlign"
        },
        "lineHeight": {
          "type": "number",
          "description": "Line height as a multiple of the largest run size on the line."
        },
        "autoWidth": {
          "type": "boolean"
        },
        "styleRef": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "align",
        "autoWidth",
        "frame",
        "id",
        "lineHeight",
        "opacity",
        "runs",
        "type"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "font": {
          "$ref": "#/definitions/FontId"
        },
        "size": {
          "type": "number",
          "description": "Points."
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "script": {
          "type": "string",
          "enum": [
            "sub",
            "sup"
          ]
        },
        "color": {
          "$ref": "#/definitions/Paint"
        }
      },
      "required": [
        "text",
        "font",
        "size",
        "color"
      ],
      "additionalProperties": false
    },
    "FontId": {
      "type": "string",
      "enum": [
        "arimo",
        "tinos",
        "cousine"
      ]
    },
    "TextAlign": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "Icon": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "icon"
        },
        "asset": {
          "$ref": "#/definitions/AssetHash"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Paint"
          },
          "description": "Overrides only; defaults come from the asset's SlotDefs."
        },
        "lockAspect": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "asset",
        "frame",
        "id",
        "lockAspect",
        "opacity",
        "slots",
        "type"
      ],
      "additionalProperties": false
    },
    "AssetHash": {
      "type": "string"
    },
    "Image": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "image"
        },
        "asset": {
          "$ref": "#/definitions/AssetHash",
          "description": "The whole picture, kept so a crop can be changed or undone (note 20). With `channels`, the merge of them, baked (note 21)."
        },
        "crop": {
          "$ref": "#/definitions/Rect4",
          "description": "What is shown, in pixels of `asset` (its `meta` size); none = all of it."
        },
        "cropped": {
          "$ref": "#/definitions/AssetHash",
          "description": "The pixels of `crop`, re-encoded as their own image asset (note 20): the export subset has no clipping, so this is what is drawn when `crop` is set."
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Channel"
          },
          "description": "A pseudocoloured merge (note 21): the channels `asset` is baked from, kept so a channel can be recoloured, re-ranged or turned off later."
        }
      },
      "required": [
        "asset",
        "frame",
        "id",
        "opacity",
        "type"
      ],
      "additionalProperties": false
    },
    "Rect4": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "Channel": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "#/definitions/AssetHash",
          "description": "The channel's own picture, as imported; its brightest of R, G, B is the intensity."
        },
        "color": {
          "type": "string",
          "description": "`#rrggbb`."
        },
        "on": {
          "type": "boolean",
          "description": "Off: left out of the merge, kept for later."
        },
        "min": {
          "type": "number",
          "description": "Intensity shown black (0–254)."
        },
        "max": {
          "type": "number",
          "description": "Intensity shown at full `color` (1–255, above `min`)."
        }
      },
      "required": [
        "asset",
        "color",
        "on",
        "min",
        "max"
      ],
      "additionalProperties": false,
      "description": "One channel of a merged picture (note 21): a single-channel picture shown in `color`, its display range `min`..`max` (0–255) stretched to full brightness."
    },
    "Procedural": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "procedural"
        },
        "kind": {
          "type": "string"
        },
        "kindVersion": {
          "type": "number"
        },
        "params": {},
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathNode"
          }
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Paint"
          }
        },
        "snapshot": {
          "$ref": "#/definitions/AssetHash",
          "description": "An `svgImport` asset drawn when the kind is unknown to this version."
        }
      },
      "required": [
        "frame",
        "id",
        "kind",
        "kindVersion",
        "opacity",
        "params",
        "slots",
        "type"
      ],
      "additionalProperties": false
    },
    "Group": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "group"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Obj"
          },
          "description": "In page coordinates; the group's frame is their bounds, rotation 0."
        }
      },
      "required": [
        "children",
        "frame",
        "id",
        "opacity",
        "type"
      ],
      "additionalProperties": false
    },
    "Panel": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "panel"
        },
        "label": {
          "type": "string"
        },
        "autoLabel": {
          "type": "boolean"
        },
        "showLabel": {
          "type": "boolean"
        },
        "showBorder": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Obj"
          },
          "description": "In page coordinates."
        }
      },
      "required": [
        "autoLabel",
        "children",
        "frame",
        "id",
        "label",
        "opacity",
        "showBorder",
        "showLabel",
        "type"
      ],
      "additionalProperties": false
    },
    "Embedded": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string"
        },
        "frame": {
          "$ref": "#/definitions/Frame"
        },
        "opacity": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "embedded"
        },
        "source": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "payload": {}
          },
          "required": [
            "app",
            "format",
            "payload"
          ],
          "additionalProperties": false
        },
        "snapshot": {
          "$ref": "#/definitions/AssetHash"
        }
      },
      "required": [
        "frame",
        "id",
        "opacity",
        "snapshot",
        "source",
        "type"
      ],
      "additionalProperties": false
    },
    "Assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Asset"
      }
    },
    "Asset": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "icon"
            },
            "svg": {
              "type": "string"
            },
            "slots": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SlotDef"
              }
            },
            "recolor": {
              "type": "string",
              "enum": [
                "slots",
                "whole"
              ]
            },
            "meta": {
              "$ref": "#/definitions/IconMeta"
            }
          },
          "required": [
            "kind",
            "svg",
            "slots",
            "recolor",
            "meta"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "image"
            },
            "mime": {
              "type": "string"
            },
            "dataBase64": {
              "type": "string"
            },
            "meta": {
              "$ref": "#/definitions/UserAssetMeta"
            }
          },
          "required": [
            "kind",
            "mime",
            "dataBase64",
            "meta"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "svgImport"
            },
            "svg": {
              "type": "string"
            },
            "meta": {
              "$ref": "#/definitions/UserAssetMeta"
            }
          },
          "required": [
            "kind",
            "svg",
            "meta"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SlotDef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/SlotId"
        },
        "label": {
          "type": "string"
        },
        "default": {
          "type": "string",
          "description": "Hex colour."
        }
      },
      "required": [
        "id",
        "label",
        "default"
      ],
      "additionalProperties": false
    },
    "SlotId": {
      "type": "string"
    },
    "IconMeta": {
      "type": "object",
      "properties": {
        "library": {
          "type": "string"
        },
        "libraryVersion": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "description": "SPDX id."
        },
        "licenseUrl": {
          "type": "string"
